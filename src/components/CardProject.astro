---
import { BASE } from "../constants";
const { project } = Astro.props;
---

<li aria-label="Project Card" class="card">
    <h2>{project.name}</h2>
    <p>{project.description}</p>
    <a href={`${BASE}/projects/${project.slug}`}>See Project</a>
</li>

<style>
    .card {
        --borderRadius: 10px;
        position: relative;
        min-width: 300px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        background-color: transparent;
        border-radius: var(--borderRadius);
        -webkit-user-select: none; /* Safari */
        -ms-user-select: none; /* IE 10 and IE 11 */
        user-select: none; /* Standard syntax */;
    }
    .card:hover {
        background-color: var(--primary-color);
    }
    .card h2 {
        font-size: 1.5em;
        margin-bottom: 16px;
    }
    .card p {
        font-size: 1em;
        color: var(--font-color);
        margin-bottom: 8px;
    }
    .card a {
        display: inline-block;
        color: inherit;
        text-decoration: none;
        transition: color 500ms, transform 500ms;
    }
    .card a:hover {
        color: var(--action-color);
        transform: scale(1.1) translateX(15px);
        text-shadow: 0px 2px 4px var(--action-color);
    }

    /** EFFECTS */
    @property --bgBorderAngle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
    }

    .card::before, .card::after {
        content: "";
        width: 100%;
        height: 100%;
        padding: -1px;
        box-sizing: content-box;
        border-radius: var(--borderRadius);
        background-image: conic-gradient(from var(--bgBorderAngle), #d90429, #ff9a26, #032ef0, #02e97d, #d90429);
        animation: bgBorderRotate 3s infinite linear;
        animation-play-state: paused;
        transition: opacity 0.5s, padding 0.5s;
        opacity: 0;

        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: -1;
    }
    .card::before {
        filter: blur(10px);
    }

    .card:hover::before, .card:hover::after {
        padding: 5px;
        animation-play-state: running;
        opacity: 1;
    }
    .card:hover::before {
        opacity: 0.5;
    }

    @keyframes bgBorderRotate {
        0% {
            --bgBorderAngle: 0deg;
        }
        100% {
            --bgBorderAngle: 360deg;
        }
    }
    
</style>